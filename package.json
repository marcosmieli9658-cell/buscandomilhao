{
  "name": "upscale-instagram-sales-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "pnpm": ">=11" },
  "scripts": {
    "dev": "concurrently -k -n painel,worker -c cyan,yellow \"next dev\" \"tsx watch src/worker/index.ts\"",
    "build": "next build",
    "start": "concurrently -k -n painel,worker -c cyan,yellow \"next start\" \"tsx src/worker/index.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "pnpm db:migrate"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "openai": "7.8.0",
    "pino": "10.1.0",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
