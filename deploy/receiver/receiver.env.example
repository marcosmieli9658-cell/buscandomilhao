# Provision only in /etc/blessia-instagram-receiver.env, root:root 0600.
# Copy the existing verification token and the existing two App Secrets securely.
# No Instagram/Page access token or outbound credential belongs on this receiver.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_EXISTING_VERIFY_TOKEN
INSTAGRAM_APP_SECRET=REPLACE_WITH_EXISTING_MAIN_APP_SECRET
INSTAGRAM_PRODUCT_APP_SECRET=REPLACE_WITH_EXISTING_PRODUCT_APP_SECRET
# Generate an independent random value (at least 32 bytes), distinct from all above.
RECEIVER_SYNC_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
